{
  "name": "outdoor-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "backend"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:backend": "npm run dev -w @outdoor-ai/backend",
    "dev:mobile": "npm start -w @outdoor-ai/mobile",
    "build": "npm run build -w @outdoor-ai/backend",
    "build:mobile": "npm run export -w @outdoor-ai/mobile",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration -w @outdoor-ai/backend",
    "prisma:validate": "npm run prisma:validate -w @outdoor-ai/backend",
    "prisma:generate": "npm run prisma:generate -w @outdoor-ai/backend",
    "db:migrate": "npm run db:migrate -w @outdoor-ai/backend",
    "db:deploy": "npm run db:deploy -w @outdoor-ai/backend",
    "env:init": "node infrastructure/init-env.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "overrides": {
    "multer": "^2.3.0",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
